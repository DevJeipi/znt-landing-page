---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ZNT | Agência de Marketing de Conteúdo",
  description = "Transformamos marcas em sistemas de crescimento através de branding, conteúdo, tráfego e automação orientados a dados.",
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="dark scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Adobe Fonts (Typekit): Roc Grotesk -->
    <link rel="stylesheet" href="https://use.typekit.net/sut5pxx.css" />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="bg-black text-white antialiased selection:bg-[#25a4ff] selection:text-white font-sans"
  >
    <slot />
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
