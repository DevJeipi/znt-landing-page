---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ZNT | Agência de Marketing de Conteúdo",
  description = "Transformamos marcas em sistemas de crescimento através de branding, conteúdo, tráfego e automação orientados a dados.",
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="dark scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Preconnects para fontes externas -->
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="preconnect" href="https://p.typekit.net" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Adobe Fonts (Typekit): Roc Grotesk (carregamento assíncrono para não bloquear renderização) -->
    <link
      rel="preload"
      as="style"
      href="https://use.typekit.net/sut5pxx.css"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link rel="stylesheet" href="https://use.typekit.net/sut5pxx.css" />
    </noscript>

    <!-- Google Fonts: Inter (apenas pesos utilizados: 400, 500, 600) -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
        rel="stylesheet"
      />
    </noscript>
  </head>
  <body
    class="bg-black text-white antialiased selection:bg-[#25a4ff] selection:text-white font-sans"
  >
    <slot />
  </body>
</html>
