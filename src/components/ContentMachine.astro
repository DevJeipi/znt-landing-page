---
const steps = [
  "Reunião de alinhamento",
  "Pré-produção",
  "Captação audiovisual",
  "Edição",
  "Planejamento de conteúdo",
  "Design",
  "Revisão interna",
  "Entrega",
  "Aprovação",
  "Alterações",
];

// Raio do anel (% do container). O anel decorativo usa o MESMO raio,
// então a linha passa exatamente pelo centro das bolinhas numeradas.
const RADIUS = 32;
const positioned = steps.map((label, i) => {
  const deg = 180 - i * 36;
  const rad = (deg * Math.PI) / 180;
  return {
    id: String(i + 1).padStart(2, "0"),
    label,
    left: 50 + RADIUS * Math.cos(rad),
    top: 50 - RADIUS * Math.sin(rad),
  };
});
const ringInset = `${50 - RADIUS}%`;
---

<section
  id="maquina"
  class="relative bg-black overflow-hidden py-6 lg:py-12 scroll-mt-24"
  aria-label="Máquina de conteúdo"
>
  <!-- Ambient background glow sutil -->
  <div
    class="absolute inset-0 pointer-events-none z-0 overflow-hidden"
    aria-hidden="true"
  >
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-[radial-gradient(circle,rgba(37,164,255,0.08)_0%,transparent_70%)] blur-[100px]"
    >
    </div>
  </div>

  <div
    class="relative z-10 w-full max-w-[1440px] mx-auto px-6 sm:px-8 lg:px-12"
  >
    <!-- Header centralizado -->
    <div class="max-w-2xl mx-auto text-center mb-12 lg:mb-0">
      <span
        class="font-roc text-primary text-xs sm:text-sm tracking-[0.15em] uppercase mb-3 block"
      >
        Máquina de conteúdo
      </span>
      <h2
        class="font-roc text-3xl sm:text-4xl lg:text-[2.75rem] leading-[1.1] tracking-tight text-white mb-4"
      >
        Da reunião ao agendamento
      </h2>
      <p class="font-sans text-sm sm:text-base text-white/60 leading-relaxed">
        Um ciclo que não para: cada entrega alimenta a próxima fase do conteúdo
        da sua marca.
      </p>
    </div>

    <!-- Anel orbital (desktop) -->
    <div
      class="relative hidden lg:block w-full max-w-[600px] aspect-square mx-auto"
      role="list"
      aria-label="Etapas da máquina de conteúdo"
    >
      {/* Anel tracejado rotativo (decorativo, mesmo raio dos nós) */}
      <div
        class="absolute rounded-full border border-dashed border-white/15 animate-orbit pointer-events-none"
        style={`inset: ${ringInset};`}
        aria-hidden="true"
      >
      </div>

      {/* Nós */}
      {
        positioned.map((step) => (
          <div
            role="listitem"
            class="absolute flex flex-col items-center text-center w-[112px] -translate-x-1/2 -translate-y-1/2"
            style={`left: ${step.left}%; top: ${step.top}%;`}
          >
            <span class="relative flex items-center justify-center w-14 h-14 rounded-full bg-[#060b14] border border-primary/40 font-roc text-base text-primary shadow-[0_0_20px_rgba(37,164,255,0.3),inset_0_1px_1px_rgba(255,255,255,0.1)]">
              {step.id}
            </span>
            <span class="mt-2 font-sans text-[11px] text-white/65 leading-snug">
              {step.label}
            </span>
          </div>
        ))
      }

      {/* Hub central */}
      <div
        class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-center"
      >
        <p
          class="font-roc text-sm tracking-[0.2em] text-white/80 uppercase leading-relaxed"
        >
          Máquina
          <br />
          de conteúdo
        </p>
        <span
          class="inline-block mt-3 px-5 py-1.5 rounded-md bg-white font-roc text-sm font-semibold tracking-wide text-black uppercase"
        >
          Agendamento
        </span>
      </div>
    </div>

    <!-- Timeline vertical (mobile/tablet) -->
    <ol
      class="lg:hidden relative ml-2 pl-8 border-l border-white/15 flex flex-col gap-7"
    >
      {
        positioned.map((step) => (
          <li class="relative flex items-center gap-4">
            <span
              class="absolute -left-8 top-1/2 -translate-y-1/2 -translate-x-1/2 flex items-center justify-center w-9 h-9 rounded-full bg-[#060b14] border border-primary/40 font-roc text-xs text-primary shadow-[0_0_16px_rgba(37,164,255,0.3)]"
              aria-hidden="true"
            >
              {step.id}
            </span>
            <span class="font-sans text-sm sm:text-base text-white/80">
              {step.label}
            </span>
          </li>
        ))
      }
      <li class="relative flex items-center gap-4">
        <span
          class="absolute -left-8 top-1/2 -translate-y-1/2 -translate-x-1/2 w-9 h-9 rounded-full bg-white/10 border border-white/25"
          aria-hidden="true"></span>
        <span
          class="inline-block px-5 py-1.5 rounded-md bg-white font-roc text-sm font-semibold tracking-wide text-black uppercase"
        >
          Agendamento
        </span>
      </li>
    </ol>
  </div>
</section>

<style>
  @keyframes orbit-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .animate-orbit {
    animation: orbit-spin 60s linear infinite;
  }

  .animate-orbit:hover {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-orbit {
      animation: none;
    }
  }
</style>
