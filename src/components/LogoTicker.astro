---
/**
 * Seção de Clientes Já Atendidos: grade de logos e wordmarks.
 */

import logo15 from "../assets/logos/logo-15.svg";
import logoCriamigos from "../assets/logos/logo-criamigos.webp";
import logoDavi from "../assets/logos/logo-davi.svg";
import logoEmergencial from "../assets/logos/logo-emergencial.svg";
import logoFlorDeLo from "../assets/logos/logo-flor-de-lo.svg";
import logoFluence from "../assets/logos/logo-fluence.svg";
import logoGrowdev from "../assets/logos/logo-growdev.webp";
import logoGrowlabs from "../assets/logos/logo-growlabs.webp";
import logoJanete from "../assets/logos/logo-janete.svg";
import logoJsMetais from "../assets/logos/logo-js-metais.svg";
import logoKazan from "../assets/logos/logo-kazan.svg";
import logoLlmix from "../assets/logos/logo-llmix.webp";
import logoLuizaBarcelos from "../assets/logos/logo-luiza-barcelos.webp";
import logoMeuSapatoColorido from "../assets/logos/logo-meu-sapato-colorido.webp";
import logoMeuSapatoPreto from "../assets/logos/logo-meu-sapato-preto.webp";
import logoSantaTeresinha from "../assets/logos/logo-santa-teresinha.svg";
import logoSapatoQueDobra from "../assets/logos/logo-sapato-que-dobra.webp";
import logoShallow from "../assets/logos/logo-shallow.svg";
import logoSl from "../assets/logos/logo-sl.svg";
import logoY2v from "../assets/logos/logo-y2v.webp";

const logos = [
  { meta: logo15, alt: "Logo 15" },
  { meta: logoLuizaBarcelos, alt: "Logo Luiza Barcelos" },
  { meta: logoLlmix, alt: "Logo LLs Mix" },
  { meta: logoDavi, alt: "Logo Davi" },
  {
    meta: logoCriamigos,
    alt: "Logo Criamigos",
    className: "max-h-10 sm:max-h-13 lg:max-h-14",
  },
  { meta: logoEmergencial, alt: "Logo Emergencial" },
  { meta: logoGrowdev, alt: "Logo Growdev" },
  {
    meta: logoFlorDeLo,
    alt: "Logo Flor de Ló",
    className: "max-h-11 sm:max-h-16 lg:max-h-[4.25rem]",
  },
  { meta: logoGrowlabs, alt: "Logo Growlabs" },
  { meta: logoFluence, alt: "Logo Fluence" },
  { meta: logoMeuSapatoPreto, alt: "Logo Meu Sapato Preto" },
  { meta: logoJanete, alt: "Logo Janete" },
  { meta: logoSapatoQueDobra, alt: "Logo Sapato que Dobra" },
  {
    meta: logoJsMetais,
    alt: "Logo JS Metais",
    className: "max-h-11 sm:max-h-16 lg:max-h-[4.25rem]",
  },
  { meta: logoMeuSapatoColorido, alt: "Logo Meu Sapato Colorido" },
  {
    meta: logoKazan,
    alt: "Logo Kazan",
    className: "max-h-6 sm:max-h-8 lg:max-h-9",
  },
  { meta: logoY2v, alt: "Logo Y2V Digital" },
  { meta: logoSantaTeresinha, alt: "Logo Santa Teresinha" },
  { meta: logoShallow, alt: "Logo Shallow" },
  { meta: logoSl, alt: "Logo SL" },
];

/**
 * Clientes ainda sem arquivo de logo: exibidos como texto (wordmark).
 * Quando o arquivo chegar, coloque em `src/assets/logos/`, importe acima
 * e mova o cliente para o array `logos`.
 */
const textLogos: string[] = [];

type ClientItem = {
  src?: string;
  width?: number;
  height?: number;
  alt?: string;
  className?: string;
  name?: string;
};

// Intercala logos e nomes para o texto não ficar agrupado
const items: ClientItem[] = [];
const max = Math.max(logos.length, textLogos.length);
for (let i = 0; i < max; i++) {
  const logoEntry = logos[i];
  if (logoEntry) {
    const { meta, alt, className } = logoEntry;
    items.push({
      src: typeof meta === "string" ? meta : meta.src,
      width: typeof meta === "string" ? undefined : meta.width,
      height: typeof meta === "string" ? undefined : meta.height,
      alt,
      className,
    });
  }
  if (textLogos[i]) items.push({ name: textLogos[i] });
}
---

<section
  id="clientes"
  class="relative bg-black overflow-hidden py-12 lg:py-16 scroll-mt-24"
  aria-label="Clientes já atendidos"
>
  <!-- Background glow azulado e textura quadriculada -->
  <div
    class="absolute inset-0 pointer-events-none z-0 overflow-hidden"
    aria-hidden="true"
  >
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(24,88,180,0.22)_0%,rgba(8,28,68,0.14)_45%,transparent_75%)]"
    >
    </div>
    <div
      class="absolute inset-0 bg-grid-pattern opacity-60 [mask-image:radial-gradient(ellipse_at_center,black_35%,transparent_80%)]"
    >
    </div>
  </div>

  <div class="relative z-10 w-full max-w-[1440px] mx-auto px-6 sm:px-8 lg:px-12">
    <!-- Cabeçalho centralizado -->
    <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-12">
      <h2
        class="font-roc font-normal text-2xl sm:text-3xl lg:text-[2.5rem] uppercase tracking-[0.06em] leading-tight text-white"
      >
        Clientes já atendidos
      </h2>
      <p class="mt-2 font-sans text-xs sm:text-sm md:text-base text-white/80">
        Marcas que escolheram crescer com estratégia
      </p>
    </div>

    <!-- Slider infinito de clientes -->
    <div class="ticker-track-container">
      <div class="ticker-track">
        {
          [0, 1].map((copy) =>
            items.map((item, i) => (
              <div
                class="ticker-item flex items-center justify-center h-16 sm:h-20"
                aria-hidden={copy === 1 ? "true" : undefined}
              >
                {item.src ? (
                  <img
                    src={item.src}
                    width={item.width}
                    height={item.height}
                    alt={copy === 1 ? "" : (item.alt ?? `Logo cliente ${i + 1}`)}
                    loading="eager"
                    decoding="async"
                    class:list={[
                      item.className ?? "max-h-8 sm:max-h-11 lg:max-h-12",
                      "w-auto max-w-[130px] sm:max-w-[165px] object-contain opacity-80 hover:opacity-100 transition-all duration-300 hover:scale-105",
                    ]}
                  />
                ) : (
                  <span class="font-roc text-sm sm:text-lg lg:text-[1.2rem] font-semibold tracking-tight text-white/80 hover:text-white text-center leading-tight whitespace-nowrap transition-all duration-300 hover:scale-105 select-none">
                    {item.name}
                  </span>
                )}
              </div>
            )),
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .ticker-track-container {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 8%,
      black 92%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 8%,
      black 92%,
      transparent 100%
    );
  }

  /*
   * Espaçamento via padding em cada item (e não `gap`): com `gap`, a metade
   * do track fica meio gap fora do início da 2ª cópia, causando um "pulo"
   * no reinício da animação.
   */
  .ticker-track {
    display: flex;
    align-items: center;
    width: max-content;
    animation: marquee 50s linear infinite;
    will-change: transform;
    backface-visibility: hidden;
  }

  .ticker-track:hover {
    animation-play-state: paused;
  }

  .ticker-item {
    flex-shrink: 0;
    padding-right: 3.5rem;
  }

  @keyframes marquee {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (max-width: 640px) {
    .ticker-track {
      animation-duration: 38s;
    }

    .ticker-item {
      padding-right: 2.25rem;
    }
  }
</style>
