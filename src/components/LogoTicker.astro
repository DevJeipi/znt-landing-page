---
/**
 * LogoTicker: carrossel horizontal automático de logos.
 * Scroll contínuo da direita para a esquerda, infinito.
 */

import logo15 from "../assets/logos/logo-15.svg";
import logoDavi from "../assets/logos/logo-davi.svg";
import logoEmergencial from "../assets/logos/logo-emergencial.svg";
import logoFlorDeLo from "../assets/logos/logo-flor-de-lo.svg";
import logoFluence from "../assets/logos/logo-fluence.svg";
import logoJanete from "../assets/logos/logo-janete.svg";
import logoJsMetais from "../assets/logos/logo-js-metais.svg";
import logoKazan from "../assets/logos/logo-kazan.svg";
import logoSantaTeresinha from "../assets/logos/logo-santa-teresinha.svg";
import logoShallow from "../assets/logos/logo-shallow.svg";
import logoSl from "../assets/logos/logo-sl.svg";

const logos = [
  logo15, logoDavi, logoEmergencial, logoFlorDeLo, logoFluence,
  logoJanete, logoJsMetais, logoKazan, logoSantaTeresinha, logoShallow, logoSl,
];

/**
 * Clientes ainda sem arquivo de logo: exibidos como texto (wordmark).
 * Quando o arquivo chegar, coloque em `src/assets/logos/`, importe acima
 * e mova o cliente para o array `logos`.
 */
const textLogos = [
  "LLs Mix",
  "Psicólogo Bauer",
  "Criamigos",
  "Growdev",
  "Growlabs",
  "Meu Sapato Preto",
  "Sapato que Dobra",
  "Meu Sapato Colorido",
  "Y2V Digital",
];

type TickerItem = { src?: string; name?: string };

// Intercala logos e nomes para o texto não ficar agrupado
const items: TickerItem[] = [];
const max = Math.max(logos.length, textLogos.length);
for (let i = 0; i < max; i++) {
  const logo = logos[i];
  if (logo) items.push({ src: typeof logo === "string" ? logo : logo.src });
  if (textLogos[i]) items.push({ name: textLogos[i] });
}
---

<div class="logo-ticker-wrapper">
  <p class="ticker-label font-roc">Marcas que crescem com a ZNT</p>

  <div class="ticker-track-container">
    <div class="ticker-track">
      {[0, 1].map((copy) =>
        items.map((item, i) => (
          <div class="ticker-item" aria-hidden={copy === 1 ? "true" : undefined}>
            {item.src ? (
              <img
                src={item.src}
                alt={copy === 1 ? "" : `Logo cliente ${i + 1}`}
                loading="lazy"
              />
            ) : (
              <span class="ticker-wordmark font-roc">{item.name}</span>
            )}
          </div>
        ))
      )}
    </div>
  </div>
</div>

<style>
  .logo-ticker-wrapper {
    width: 100%;
    margin-top: 2.5rem;
  }

  .ticker-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.35);
    margin-bottom: 1rem;
  }

  .ticker-track-container {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
  }

  .ticker-track {
    display: flex;
    align-items: center;
    gap: 3rem;
    width: max-content;
    animation: marquee 55s linear infinite;
  }

  .ticker-item {
    flex-shrink: 0;
  }

  .ticker-item img {
    height: 32px;
    width: auto;
    object-fit: contain;
    opacity: 0.6;
    transition: opacity 0.3s ease;
  }

  .ticker-item img:hover {
    opacity: 1;
  }

  .ticker-wordmark {
    display: block;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 32px;
    white-space: nowrap;
    color: #fff;
    opacity: 0.6;
    transition: opacity 0.3s ease;
  }

  .ticker-wordmark:hover {
    opacity: 1;
  }

  @keyframes marquee {
    0% {
      transform: translateX(-50%);
    }
    100% {
      transform: translateX(0);
    }
  }

  @media (max-width: 640px) {
    .ticker-track {
      gap: 2rem;
      animation-duration: 40s;
    }

    .ticker-item img {
      height: 24px;
    }

    .ticker-wordmark {
      font-size: 0.9rem;
      line-height: 24px;
    }

    .ticker-label {
      text-align: center;
    }
  }
</style>
