---
/**
 * Seção de Clientes Já Atendidos: grade de logos e wordmarks.
 */

import logo15 from "../assets/logos/logo-15.svg";
import logoDavi from "../assets/logos/logo-davi.svg";
import logoEmergencial from "../assets/logos/logo-emergencial.svg";
import logoFlorDeLo from "../assets/logos/logo-flor-de-lo.svg";
import logoFluence from "../assets/logos/logo-fluence.svg";
import logoJanete from "../assets/logos/logo-janete.svg";
import logoJsMetais from "../assets/logos/logo-js-metais.svg";
import logoKazan from "../assets/logos/logo-kazan.svg";
import logoSantaTeresinha from "../assets/logos/logo-santa-teresinha.svg";
import logoShallow from "../assets/logos/logo-shallow.svg";
import logoSl from "../assets/logos/logo-sl.svg";

const logos = [
  { meta: logo15, alt: "Logo 15" },
  { meta: logoDavi, alt: "Logo Davi" },
  { meta: logoEmergencial, alt: "Logo Emergencial" },
  { meta: logoFlorDeLo, alt: "Logo Flor de Ló" },
  { meta: logoFluence, alt: "Logo Fluence" },
  { meta: logoJanete, alt: "Logo Janete" },
  { meta: logoJsMetais, alt: "Logo JS Metais" },
  { meta: logoKazan, alt: "Logo Kazan" },
  { meta: logoSantaTeresinha, alt: "Logo Santa Teresinha" },
  { meta: logoShallow, alt: "Logo Shallow" },
  { meta: logoSl, alt: "Logo SL" },
];

/**
 * Clientes ainda sem arquivo de logo: exibidos como texto (wordmark).
 * Quando o arquivo chegar, coloque em `src/assets/logos/`, importe acima
 * e mova o cliente para o array `logos`.
 */
const textLogos = [
  "LLs Mix",
  "Psicólogo Bauer",
  "Criamigos",
  "Growdev",
  "Growlabs",
  "Meu Sapato Preto",
  "Sapato que Dobra",
  "Meu Sapato Colorido",
  "Y2V Digital",
];

type ClientItem = {
  src?: string;
  width?: number;
  height?: number;
  alt?: string;
  name?: string;
};

// Intercala logos e nomes para o texto não ficar agrupado
const items: ClientItem[] = [];
const max = Math.max(logos.length, textLogos.length);
for (let i = 0; i < max; i++) {
  const logoEntry = logos[i];
  if (logoEntry) {
    const { meta, alt } = logoEntry;
    items.push({
      src: typeof meta === "string" ? meta : meta.src,
      width: typeof meta === "string" ? undefined : meta.width,
      height: typeof meta === "string" ? undefined : meta.height,
      alt,
    });
  }
  if (textLogos[i]) items.push({ name: textLogos[i] });
}
---

<section
  id="clientes"
  class="relative bg-black overflow-hidden py-16 lg:py-24 scroll-mt-24"
  aria-label="Clientes já atendidos"
>
  <!-- Background glow azulado e textura quadriculada como na referência -->
  <div
    class="absolute inset-0 pointer-events-none z-0 overflow-hidden"
    aria-hidden="true"
  >
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(24,88,180,0.22)_0%,rgba(8,28,68,0.14)_45%,transparent_75%)]"
    >
    </div>
    <div
      class="absolute inset-0 bg-grid-pattern opacity-60 [mask-image:radial-gradient(ellipse_at_center,black_35%,transparent_80%)]"
    >
    </div>
  </div>

  <div class="relative z-10 w-full max-w-[1320px] mx-auto px-6 sm:px-8 lg:px-12">
    <!-- Cabeçalho centralizado -->
    <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16 lg:mb-20">
      <h2
        class="font-roc font-normal text-2xl sm:text-3xl lg:text-[2.5rem] uppercase tracking-[0.06em] leading-tight text-white"
      >
        Clientes já atendidos
      </h2>
      <p class="mt-2 font-sans text-xs sm:text-sm md:text-base text-white/80">
        Marcas que escolheram crescer com estratégia
      </p>
    </div>

    <!-- Grade de clientes -->
    <ul
      class="grid grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-x-4 gap-y-8 sm:gap-x-10 sm:gap-y-14 items-center justify-items-center"
    >
      {
        items.map((item, i) => (
          <li class="flex items-center justify-center w-full h-12 sm:h-16 px-1 sm:px-2">
            {item.src ? (
              <img
                src={item.src}
                width={item.width}
                height={item.height}
                alt={item.alt ?? `Logo cliente ${i + 1}`}
                loading="lazy"
                decoding="async"
                class="max-h-7 sm:max-h-11 lg:max-h-12 w-auto max-w-[95px] sm:max-w-[160px] object-contain opacity-85 hover:opacity-100 transition-all duration-300 hover:scale-105"
              />
            ) : (
              <span class="font-roc text-xs sm:text-lg lg:text-[1.2rem] font-semibold tracking-tight text-white/85 hover:text-white text-center leading-tight transition-all duration-300 hover:scale-105 select-none">
                {item.name}
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>
