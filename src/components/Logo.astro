---
import logoImage from "../assets/logos/logo-completa-azul-branco-2.webp";
import { Image } from "astro:assets";
import type { Locale } from "../data/site";

interface Props {
  class?: string;
  loading?: "eager" | "lazy";
  lang?: Locale;
}

const { class: className = "", loading = "eager", lang = "pt" } = Astro.props;
const isEn = lang === "en";
---

<a
  href="#hero"
  class={`inline-flex items-center group ${className}`}
  aria-label={isEn ? "ZNT Marketing - Home" : "ZNT Marketing - Página inicial"}
>
  <Image
    src={logoImage}
    alt="Logo ZNT Marketing"
    widths={[160, 240]}
    sizes="120px"
    class="h-8 sm:h-9 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
    loading={loading}
    decoding="async"
  />
</a>
