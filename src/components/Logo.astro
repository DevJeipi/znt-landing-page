---
import logoImage from "../assets/logos/logo-completa-azul-branco-2.webp";
import { Image } from "astro:assets";

interface Props {
  class?: string;
  loading?: "eager" | "lazy";
}

const { class: className = "", loading = "eager" } = Astro.props;
---

<a
  href="#hero"
  class={`inline-flex items-center group ${className}`}
  aria-label="ZNT Marketing - Página inicial"
>
  <Image
    src={logoImage}
    alt="Logo ZNT Marketing"
    widths={[160, 240]}
    sizes="120px"
    class="h-8 sm:h-9 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
    loading={loading}
    decoding="async"
  />
</a>
