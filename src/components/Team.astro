---
import { MapPin, ArrowUpRight, Users } from "lucide-astro";

/**
 * COMO ADICIONAR AS FOTOS:
 *
 * 1. Coloque os arquivos em `src/assets/team/` (ex: `time.jpg`, `escritorio.jpg`).
 * 2. Importe no topo: `import teamPhoto from "../assets/team/time.jpg";`
 * 3. Troque `null` abaixo pelo import (`const teamImage = teamPhoto;`).
 * Sem foto, o bloco usa o fundo decorativo em glow azul.
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import officePhoto1 from "../assets/team/escritorio.webp";
import officePhoto2 from "../assets/team/escritorio-2.webp";
import { SITE, mapsUrl } from "../data/site";

const teamImage: ImageMetadata | null = null;

const officePhotos: { image: ImageMetadata; alt: string; caption: string }[] = [
  {
    image: officePhoto1,
    alt: "Espaço de trabalho da equipe no escritório da ZNT Marketing em Campo Bom",
    caption: "Nosso escritório",
  },
  {
    image: officePhoto2,
    alt: "Sala de reuniões do escritório da ZNT Marketing em Campo Bom",
    caption: "Sala de reuniões",
  },
];

const address = {
  street: SITE.address.streetAddress,
  city: `${SITE.address.neighborhood}, ${SITE.address.addressLocality} - ${SITE.address.addressRegion}`,
};
---

<section
  id="time"
  class="relative bg-black overflow-hidden py-12 lg:py-20 scroll-mt-24"
  aria-label="Nosso time"
>
  <!-- Ambient background glow sutil -->
  <div
    class="absolute inset-0 pointer-events-none z-0 overflow-hidden"
    aria-hidden="true"
  >
    <div
      class="absolute top-1/3 left-0 w-[500px] h-[500px] rounded-full bg-[radial-gradient(circle,rgba(37,164,255,0.08)_0%,transparent_70%)] blur-[100px]"
    >
    </div>
  </div>

  <div
    class="relative z-10 w-full max-w-[1440px] mx-auto px-6 sm:px-8 lg:px-12"
  >
    <!-- Header -->
    <div class="max-w-xl mb-10 lg:mb-12">
      <span
        class="font-roc text-primary text-xs sm:text-sm tracking-[0.15em] uppercase mb-3 block"
      >
        Nosso time
      </span>
      <h2
        class="font-roc text-3xl sm:text-4xl lg:text-[2.75rem] leading-[1.1] tracking-tight text-white"
      >
        Quem faz a ZNT acontecer
      </h2>
    </div>

    <div
      class="grid grid-cols-1 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] gap-4 lg:gap-5"
    >
      <!-- Foto do time -->
      <figure
        class="relative overflow-hidden rounded-3xl border border-white/[0.08] bg-[#060b14]/60 aspect-[4/3] lg:aspect-auto lg:min-h-[480px]"
      >
        {
          teamImage ? (
            <Image
              src={teamImage}
              alt="Time da ZNT Marketing"
              class="absolute inset-0 w-full h-full object-cover"
              widths={[640, 960, 1440]}
              sizes="(max-width: 1024px) 100vw, 60vw"
            />
          ) : (
            <div
              class="absolute inset-0 bg-grid-pattern flex items-center justify-center"
              aria-hidden="true"
            >
              <div class="absolute -top-10 left-1/4 w-72 h-72 rounded-full bg-[radial-gradient(circle,rgba(37,164,255,0.3)_0%,transparent_70%)] blur-[60px]" />
              <Users
                class="relative w-12 h-12 text-white/15"
                stroke-width={1.25}
              />
            </div>
          )
        }
        <div
          class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-black/80 to-transparent pointer-events-none"
          aria-hidden="true"
        >
        </div>
        <figcaption
          class="absolute left-6 bottom-5 font-roc text-xs tracking-[0.15em] uppercase text-white/70"
        >
          Time ZNT
        </figcaption>
      </figure>

      <!-- Escritório + endereço -->
      <div class="flex flex-col gap-4 lg:gap-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-4 lg:gap-5 flex-1">
          {
            officePhotos.map((photo) => (
              <figure class="group relative overflow-hidden rounded-3xl border border-white/[0.08] bg-[#060b14]/60 aspect-[16/10] lg:aspect-auto lg:min-h-[215px]">
                <img
                  src={photo.image.src}
                  width={photo.image.width}
                  height={photo.image.height}
                  alt={photo.alt}
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <div
                  class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-black/80 to-transparent pointer-events-none"
                  aria-hidden="true"
                />
                <figcaption class="absolute left-6 bottom-5 font-roc text-xs tracking-[0.15em] uppercase text-white/70">
                  {photo.caption}
                </figcaption>
              </figure>
            ))
          }
        </div>

        <a
          href={mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative overflow-hidden rounded-3xl p-6 sm:p-7 flex items-center gap-5 bg-[#060b14]/60 backdrop-blur-xl border border-white/[0.08] shadow-[inset_0_1px_1px_rgba(255,255,255,0.1),0_8px_20px_rgba(0,0,0,0.4)] transition-all duration-300 hover:border-primary/50 hover:shadow-[inset_0_1px_1px_rgba(255,255,255,0.15),0_10px_30px_rgba(37,164,255,0.18)]"
        >
          <span
            class="w-12 h-12 shrink-0 rounded-xl bg-primary/10 border border-primary/25 flex items-center justify-center text-primary group-hover:border-primary/50 group-hover:bg-primary/20 transition-all duration-300"
          >
            <MapPin class="w-5 h-5" stroke-width={1.75} aria-hidden="true" />
          </span>
          <address class="flex-1 min-w-0 not-italic">
            <span
              class="block font-roc text-base sm:text-lg text-white leading-snug"
            >
              {address.street}
            </span>
            <span class="block font-sans text-sm text-white/55">
              {address.city}
            </span>
          </address>
          <ArrowUpRight
            class="w-5 h-5 shrink-0 text-white/30 transition-all duration-300 group-hover:text-primary group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            aria-hidden="true"
          />
          <span class="sr-only">(abre no Google Maps)</span>
        </a>
      </div>
    </div>
  </div>
</section>
