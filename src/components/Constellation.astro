---
import { Asterisk, ChevronDown } from "lucide-astro";

interface Pillar {
  id: string;
  name: string;
  tagline: string;
  description: string;
  color: string;
  items: string[];
}

const pillars: Pillar[] = [
  {
    id: "estrategia",
    name: "Estratégia",
    tagline: "Posicione sua marca para ser escolhida.",
    description:
      "Construímos o posicionamento e a comunicação da sua empresa para gerar valor, atrair clientes e fortalecer sua presença no mercado.",
    color: "#7ec9ff",
    items: [
      "Diagnóstico Macro",
      "Planejamento de conteúdo",
      "Conteúdo",
      "Design",
      "Sites e Landing Pages",
      "Branding",
      "Identidade Visual",
      "Audiovisual",
      "Gestão das redes sociais",
    ],
  },
  {
    id: "performance",
    name: "Performance",
    tagline: "Aumente sua receita.",
    description:
      "Atraímos oportunidades, otimizamos seus investimentos e conectamos o marketing às vendas para gerar mais receita para sua empresa.",
    color: "#e3e36d",
    items: [
      "Diagnóstico do Funil de Vendas",
      "Análise de Métricas",
      "CRM & Automação",
      "Tráfego Pago / Mídia Paga",
      "Relatórios de Performance",
      "Estratégia Comercial",
      "Geração de Oportunidades",
      "Gestão de Vendas",
    ],
  },
  {
    id: "inovacao",
    name: "Inovação",
    tagline: "Aumente sua eficiência operacional com tecnologia.",
    description:
      "Aplicamos inteligência artificial, automação e tecnologia para reduzir processos manuais, ganhar eficiência e preparar sua empresa para o próximo nível.",
    color: "#68eaa9",
    items: [
      "Tecnologia",
      "Soluções",
      "Inteligência Artificial",
      "Softwares",
      "Desenvolvimento Web",
    ],
  },
];

const pad = (n: number) => String(n).padStart(2, "0");
---

<section
  id="constelacao"
  class="relative bg-black py-12 lg:py-20 scroll-mt-24"
  aria-label="Constelação de serviços ZNT"
>
  <div class="relative z-10 w-full max-w-[1440px] mx-auto px-6 sm:px-8 lg:px-12">
    <!-- Header -->
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4 mb-10 lg:mb-6">
      <div class="max-w-xl">
        <span
          class="font-roc text-primary text-xs sm:text-sm tracking-[0.15em] uppercase mb-3 block"
        >
          Constelação ZNT
        </span>
        <h2
          class="font-roc text-3xl sm:text-4xl lg:text-[2.75rem] leading-[1.1] tracking-tight text-white"
        >
          Três pilares dos nossos serviços
        </h2>
      </div>
      <p class="font-sans text-xs sm:text-sm tracking-[0.15em] uppercase text-white/35">
        Escolha um pilar e explore
      </p>
    </div>

    <div class="lg:grid lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
      <!-- Índice fixo (desktop): acende conforme o scroll -->
      <div class="hidden lg:block">
        <nav class="sticky top-32 border-b border-white/10" aria-label="Pilares">
          {
            pillars.map((pillar, index) => (
              <a
                href={`#pilar-${pillar.id}`}
                data-pillar-nav={pillar.id}
                data-active={index === 0 ? "true" : "false"}
                class="pillar-nav group flex items-center gap-5 py-7 border-t border-white/10"
                style={`--pillar: ${pillar.color};`}
              >
                <Asterisk
                  class="pillar-star w-11 h-11 shrink-0 transition-all duration-500"
                  style={`color: ${pillar.color};`}
                  aria-hidden="true"
                />
                <span class="flex-1 min-w-0">
                  <span class="pillar-name block font-roc font-medium tracking-tight leading-none text-[clamp(2.25rem,4vw,3.75rem)] transition-colors duration-500">
                    {pillar.name}
                  </span>
                  <span class="mt-2 block font-sans text-sm text-white/40">
                    {pad(pillar.items.length)} entregáveis
                  </span>
                </span>
                <span class="font-roc text-sm text-white/25">
                  {pad(index + 1)}/{pad(pillars.length)}
                </span>
              </a>
            ))
          }
        </nav>
      </div>

      <!-- Painéis: um por pilar (entregáveis recolhidos no mobile, sempre abertos no desktop) -->
      <div class="flex flex-col gap-5 lg:gap-0">
        {
          pillars.map((pillar, index) => (
            <article
              id={`pilar-${pillar.id}`}
              data-pillar-panel={pillar.id}
              data-active={index === 0 ? "true" : "false"}
              data-expanded="false"
              class="pillar-panel scroll-mt-28 lg:min-h-[70vh] lg:flex lg:items-center lg:py-8"
              style={`--pillar: ${pillar.color};`}
              aria-labelledby={`pilar-${pillar.id}-title`}
            >
              <div class="pillar-card relative w-full overflow-hidden rounded-3xl p-7 sm:p-10 bg-[#060b14]/60 backdrop-blur-xl border cursor-pointer lg:cursor-default">
                {/* Glow na cor do pilar */}
                <div
                  class="pillar-glow absolute -top-24 -right-24 w-80 h-80 rounded-full blur-[90px] pointer-events-none"
                  style={`background: ${pillar.color};`}
                  aria-hidden="true"
                />

                <div class="relative z-10">
                  <div class="flex items-center gap-3 mb-6">
                    <Asterisk
                      class="pillar-star w-7 h-7 shrink-0 transition-all duration-500"
                      style={`color: ${pillar.color};`}
                      aria-hidden="true"
                    />
                    <span
                      class="font-roc text-sm tracking-[0.15em] uppercase"
                      style={`color: ${pillar.color};`}
                    >
                      {pillar.name}
                    </span>
                    <span class="ml-auto font-sans text-xs sm:text-sm text-white/40">
                      {pad(pillar.items.length)} entregáveis
                    </span>
                  </div>

                  <h3
                    id={`pilar-${pillar.id}-title`}
                    class="font-roc text-2xl sm:text-3xl lg:text-[2.25rem] leading-[1.1] tracking-tight text-white mb-4"
                  >
                    {pillar.tagline}
                  </h3>
                  <p class="font-sans text-sm sm:text-base text-white/60 leading-relaxed max-w-2xl mb-5 lg:mb-7">
                    {pillar.description}
                  </p>

                  {/* Botão de expandir/recolher entregáveis (apenas mobile) */}
                  <button
                    type="button"
                    data-pillar-toggle={pillar.id}
                    aria-expanded="false"
                    aria-controls={`pilar-${pillar.id}-deliverables`}
                    class="pillar-toggle lg:hidden flex w-full items-center justify-between gap-3 pt-4 border-t border-white/10 font-roc text-sm text-white/80 transition-colors duration-300 hover:text-white cursor-pointer"
                  >
                    <span class="flex items-center gap-2.5">
                      <span
                        class="w-1.5 h-1.5 rounded-full transition-transform duration-300"
                        style={`background-color: ${pillar.color};`}
                        aria-hidden="true"
                      />
                      <span
                        data-toggle-label
                        data-count={pad(pillar.items.length)}
                      >
                        Ver {pad(pillar.items.length)} entregáveis
                      </span>
                    </span>
                    <span
                      class="pillar-toggle-icon inline-flex items-center justify-center w-7 h-7 rounded-full bg-white/[0.05] border border-white/15 transition-all duration-300"
                      aria-hidden="true"
                    >
                      <ChevronDown class="w-4 h-4 transition-transform duration-300" />
                    </span>
                  </button>

                  <div
                    id={`pilar-${pillar.id}-deliverables`}
                    class="pillar-deliverables"
                  >
                    <div class="overflow-hidden">
                      <ul class="flex flex-wrap gap-2.5 pt-5 lg:pt-0">
                        {pillar.items.map((item, i) => (
                          <li
                            class="pillar-chip inline-flex items-center px-5 py-2.5 rounded-full font-roc text-sm text-white bg-white/[0.04] border border-white/15 transition-all duration-300 hover:bg-white/10 hover:border-[var(--pillar)] hover:shadow-[0_0_14px_-4px_var(--pillar)]"
                            style={`--i: ${i};`}
                          >
                            {item}
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const panels = document.querySelectorAll<HTMLElement>("[data-pillar-panel]");
  const navs = document.querySelectorAll<HTMLElement>("[data-pillar-nav]");

  // Revelação dos entregáveis só acontece com JS ativo
  panels.forEach((panel, i) => {
    if (i > 0) panel.setAttribute("data-seen", "false");
  });

  function activate(id: string) {
    panels.forEach((panel) => {
      const isActive = panel.dataset.pillarPanel === id;
      panel.setAttribute("data-active", String(isActive));
      if (isActive) panel.setAttribute("data-seen", "true");
    });
    navs.forEach((nav) => {
      nav.setAttribute("data-active", String(nav.dataset.pillarNav === id));
    });
  }

  function toggleDeliverables(panel: HTMLElement) {
    const isExpanded = panel.getAttribute("data-expanded") === "true";
    const nextState = !isExpanded;
    panel.setAttribute("data-expanded", String(nextState));

    const toggleBtn = panel.querySelector<HTMLButtonElement>("[data-pillar-toggle]");
    const labelEl = panel.querySelector<HTMLElement>("[data-toggle-label]");

    if (toggleBtn) {
      toggleBtn.setAttribute("aria-expanded", String(nextState));
    }
    if (labelEl) {
      const count = labelEl.dataset.count ?? "";
      labelEl.textContent = nextState
        ? "Ocultar entregáveis"
        : `Ver ${count} entregáveis`;
    }

    if (nextState && panel.dataset.pillarPanel) {
      activate(panel.dataset.pillarPanel);
    }
  }

  panels.forEach((panel) => {
    const card = panel.querySelector<HTMLElement>(".pillar-card");
    const toggleBtn = panel.querySelector<HTMLButtonElement>("[data-pillar-toggle]");

    toggleBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      toggleDeliverables(panel);
    });

    card?.addEventListener("click", () => {
      if (window.matchMedia("(max-width: 1023px)").matches) {
        toggleDeliverables(panel);
      }
    });
  });

  // O pilar que cruza a faixa central da tela abre automaticamente
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const id = (entry.target as HTMLElement).dataset.pillarPanel;
        if (entry.isIntersecting && id) activate(id);
      });
    },
    { rootMargin: "-45% 0px -45% 0px", threshold: 0 },
  );

  panels.forEach((panel) => observer.observe(panel));
</script>

<style>
  /* Índice (desktop) */
  .pillar-nav .pillar-name {
    color: rgba(255, 255, 255, 0.25);
  }
  .pillar-nav:hover .pillar-name {
    color: rgba(255, 255, 255, 0.5);
  }
  .pillar-nav[data-active="true"] .pillar-name {
    color: var(--pillar);
  }
  .pillar-nav .pillar-star {
    opacity: 0.35;
  }
  .pillar-nav[data-active="true"] .pillar-star {
    opacity: 1;
    transform: rotate(45deg);
    filter: drop-shadow(0 0 12px currentColor);
  }

  /* Painéis */
  .pillar-panel {
    opacity: 0.5;
    transition: opacity 0.6s ease;
  }
  .pillar-panel[data-active="true"] {
    opacity: 1;
  }
  .pillar-card {
    border-color: rgba(255, 255, 255, 0.08);
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.1),
      0 8px 20px rgba(0, 0, 0, 0.4);
    transition:
      border-color 0.6s ease,
      box-shadow 0.6s ease;
  }
  .pillar-panel[data-active="true"] .pillar-card {
    border-color: color-mix(in srgb, var(--pillar) 45%, transparent);
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.12),
      0 0 50px -18px var(--pillar);
  }
  .pillar-glow {
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .pillar-panel[data-active="true"] .pillar-glow {
    opacity: 0.18;
  }
  .pillar-panel[data-active="true"] .pillar-card .pillar-star {
    transform: rotate(45deg);
    filter: drop-shadow(0 0 10px currentColor);
  }

  /* Accordion de entregáveis no mobile */
  .pillar-deliverables {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.35s ease;
  }
  .pillar-panel[data-expanded="true"] .pillar-deliverables {
    grid-template-rows: 1fr;
    opacity: 1;
  }
  .pillar-panel[data-expanded="true"] .pillar-toggle {
    color: var(--pillar);
  }
  .pillar-panel[data-expanded="true"] .pillar-toggle-icon {
    border-color: color-mix(in srgb, var(--pillar) 50%, transparent);
    background-color: color-mix(in srgb, var(--pillar) 12%, transparent);
    color: var(--pillar);
  }
  .pillar-panel[data-expanded="true"] .pillar-toggle-icon svg {
    transform: rotate(180deg);
  }

  @media (min-width: 1024px) {
    .pillar-deliverables {
      grid-template-rows: 1fr;
      opacity: 1;
    }
  }

  /* Entregáveis entram em sequência */
  .pillar-panel .pillar-chip {
    transition:
      opacity 0.5s ease calc(var(--i) * 60ms),
      transform 0.5s ease calc(var(--i) * 60ms),
      background-color 0.3s,
      border-color 0.3s,
      box-shadow 0.3s;
  }
  @media (max-width: 1023px) {
    .pillar-panel[data-expanded="false"] .pillar-chip {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  @media (min-width: 1024px) {
    .pillar-panel[data-seen="false"] .pillar-chip {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pillar-panel[data-seen="false"] .pillar-chip,
    .pillar-panel[data-expanded="false"] .pillar-chip {
      opacity: 1;
      transform: none;
    }
  }
</style>
