---
/**
 * Perguntas frequentes (FAQ). O conteúdo vem de `src/data/site.ts` e também é
 * publicado como FAQPage (JSON-LD) no Layout: respostas diretas e objetivas
 * ajudam a ZNT a aparecer em respostas do Google e de IAs generativas (AEO/GEO).
 */
import { Plus } from "lucide-astro";
import { faqs } from "../data/site";
---

<section
  id="perguntas-frequentes"
  class="relative bg-black overflow-hidden py-12 lg:py-20 scroll-mt-24"
  aria-labelledby="faq-title"
>
  <!-- Ambient background glow sutil -->
  <div
    class="absolute inset-0 pointer-events-none z-0 overflow-hidden"
    aria-hidden="true"
  >
    <div
      class="absolute bottom-0 left-1/4 w-[500px] h-[500px] rounded-full bg-[radial-gradient(circle,rgba(37,164,255,0.08)_0%,transparent_70%)] blur-[100px]"
    >
    </div>
  </div>

  <div
    class="relative z-10 w-full max-w-[1440px] mx-auto px-6 sm:px-8 lg:px-12 lg:grid lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-start lg:gap-16"
  >
    <!-- Header -->
    <div class="max-w-xl mb-10 lg:mb-0 lg:sticky lg:top-32">
      <span
        class="font-roc text-primary text-xs sm:text-sm tracking-[0.15em] uppercase mb-3 block"
      >
        Perguntas frequentes
      </span>
      <h2
        id="faq-title"
        class="font-roc text-3xl sm:text-4xl lg:text-[2.75rem] leading-[1.1] tracking-tight text-white"
      >
        Tudo o que você precisa saber sobre a ZNT
      </h2>
    </div>

    <!-- Lista de perguntas (conteúdo sempre presente no HTML, legível por buscadores) -->
    <div class="flex flex-col border-b border-white/10">
      {
        faqs.map((faq, i) => (
          <div
            class="faq-item border-t border-white/10"
            data-faq-item
            data-expanded="false"
          >
            <h3 class="font-roc text-lg sm:text-xl text-white">
              <button
                type="button"
                data-faq-trigger
                aria-expanded="false"
                aria-controls={`faq-panel-${i}`}
                id={`faq-trigger-${i}`}
                class="flex w-full cursor-pointer items-center justify-between gap-5 py-6 text-left font-[inherit] text-[inherit] text-white transition-colors duration-300 hover:text-primary-light select-none"
              >
                <span>{faq.question}</span>
                <span
                  class="faq-icon inline-flex items-center justify-center w-8 h-8 shrink-0 rounded-full bg-white/[0.05] border border-white/15 text-white/70 transition-all duration-300"
                  aria-hidden="true"
                >
                  <Plus class="w-4 h-4" />
                </span>
              </button>
            </h3>
            <div
              id={`faq-panel-${i}`}
              role="region"
              aria-labelledby={`faq-trigger-${i}`}
              class="faq-content"
            >
              <div class="faq-inner">
                <p class="pb-6 pr-6 sm:pr-12 font-sans text-sm sm:text-base text-white/60 leading-relaxed">
                  {faq.answer}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  const faqItems = document.querySelectorAll<HTMLElement>("[data-faq-item]");

  faqItems.forEach((item) => {
    const trigger = item.querySelector<HTMLButtonElement>("[data-faq-trigger]");
    if (!trigger) return;

    trigger.addEventListener("click", () => {
      const isExpanded = item.getAttribute("data-expanded") === "true";
      const nextState = !isExpanded;
      item.setAttribute("data-expanded", String(nextState));
      trigger.setAttribute("aria-expanded", String(nextState));
    });
  });
</script>

<style>
  .faq-item {
    overflow-anchor: none;
  }

  .faq-icon svg {
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .faq-item[data-expanded="true"] .faq-icon {
    color: var(--color-primary);
    border-color: color-mix(in srgb, var(--color-primary) 50%, transparent);
    background-color: color-mix(in srgb, var(--color-primary) 12%, transparent);
  }

  .faq-item[data-expanded="true"] .faq-icon svg {
    transform: rotate(45deg);
  }

  /* Expansão e recolhimento suave para baixo via CSS Grid */
  .faq-content {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.35s ease;
  }

  .faq-inner {
    overflow: hidden;
    min-height: 0;
  }

  .faq-inner p {
    transform: translateY(-6px);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .faq-item[data-expanded="true"] .faq-content {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .faq-item[data-expanded="true"] .faq-inner p {
    transform: translateY(0);
  }
</style>
