---
import { ArrowUpRight } from "lucide-astro";
import caseClube15 from "../assets/cases/case-clube15.webp";
import caseFlordelo from "../assets/cases/case-flordelo.webp";
import caseFluence from "../assets/cases/case-fluence.webp";
import caseSantaTeresinha from "../assets/cases/case-santateresinha.webp";
import caseShallow from "../assets/cases/case-shallow.webp";

/**
 * COMO ADICIONAR FOTO OU VÍDEO EM UM CASE:
 *
 * 1. Coloque o arquivo em `src/assets/cases/` (ex: `case-saude.webp`, `case-ecommerce.mp4`).
 * 2. Foto:  importe no topo (`import caseSaude from "../assets/cases/case-saude.webp"`)
 *           e defina `mediaType: "image", mediaSrc: caseSaude.src`.
 * 3. Vídeo: importe ou aponte para `/cases/case-ecommerce.mp4` (pasta `public/cases/`)
 *           e defina `mediaType: "video", mediaSrc: "/cases/case-ecommerce.mp4"`.
 *           O vídeo roda em loop, sem som (autoplay muted) e usa `poster` como capa.
 * 4. Sem mídia: basta omitir `mediaType`: o card usa o fundo decorativo em glow azul.
 */

interface CaseMetric {
  value: string;
  label: string;
}

interface CaseItem {
  id: string;
  tag: string;
  title: string;
  metrics?: CaseMetric[];
  deliverables?: string[];
  href?: string;
  mediaType?: "image" | "video";
  mediaSrc?: string;
  poster?: string;
}

const cases: CaseItem[] = [
  {
    id: "moda-praia",
    tag: "Audiovisual + Mídia paga",
    title: "Reposicionamento de marca do segmento de moda praia e fitness",
    mediaType: "image",
    mediaSrc: caseShallow.src,
    metrics: [
      { value: "+312%", label: "Leads" },
      { value: "-27%", label: "CAC" },
      { value: "+5,8x", label: "ROAS" },
    ],
  },
  {
    id: "massoterapeuta",
    tag: "Branding + Identidade visual",
    title:
      "Posicionamento de marca, identidade visual, tom de voz e criação de um ecossistema de serviços para uma massoterapeuta",
    deliverables: ["Identidade Visual", "Branding", "Design de produto"],
  },
  {
    id: "clube-esportivo",
    tag: "Gestão de redes sociais",
    title:
      "Ressignificando e dando propósito a um clube esportivo através de uma comunicação estratégica nas redes sociais",
    mediaType: "image",
    mediaSrc: caseClube15.src,
    metrics: [
      { value: "+182%", label: "Visualizações orgânicas" },
      { value: "+548%", label: "Interações" },
      { value: "+10.893", label: "Visitas ao perfil/mês" },
    ],
  },
  {
    id: "delivery",
    tag: "Audiovisual + Mídia paga",
    title:
      "Crescimento de 104,8% nos pedidos via delivery no mês, através de conteúdo orgânico e mídia paga",
    mediaType: "image",
    mediaSrc: caseFlordelo.src,
    metrics: [
      { value: "-11,22%", label: "CAC" },
      { value: "+104,8%", label: "Pedidos" },
      { value: "9,2x", label: "ROAS" },
    ],
  },
  {
    id: "estilistas",
    tag: "Gestão de redes sociais",
    title:
      "Após identificarmos estilistas como público-alvo, direcionamos a comunicação para moda e estilo, transformando o conteúdo em um canal de aquisição",
    mediaType: "image",
    mediaSrc: caseFluence.src,
    metrics: [
      { value: "+76%", label: "Pedidos fechados" },
      { value: "+142%", label: "Alcance orgânico" },
      { value: "+62%", label: "Contatos qualificados" },
    ],
  },
  {
    id: "escola",
    tag: "Audiovisual",
    title:
      "Estratégia de aquisição para transformar a campanha de matrículas em um canal de entrada de novos alunos para a escola",
    mediaType: "image",
    mediaSrc: caseSantaTeresinha.src,
    metrics: [
      { value: "+33%", label: "Novas matrículas" },
      { value: "+127%", label: "Leads interessados" },
      { value: "-61%", label: "Custo por lead" },
    ],
  },
];
---

<section
  id="cases"
  class="relative bg-black overflow-hidden py-12 lg:py-20 scroll-mt-24"
  aria-label="Cases de sucesso"
>
  <!-- Ambient background glow sutil -->
  <div
    class="absolute inset-0 pointer-events-none z-0 overflow-hidden"
    aria-hidden="true"
  >
    <div
      class="absolute top-0 right-1/4 w-[500px] h-[500px] rounded-full bg-[radial-gradient(circle,rgba(37,164,255,0.08)_0%,transparent_70%)] blur-[100px]"
    >
    </div>
  </div>

  <div class="relative z-10 w-full max-w-[1440px] mx-auto px-6 sm:px-8 lg:px-12">
    <!-- Header: label + título -->
    <div class="max-w-xl mb-10 lg:mb-12">
      <span
        class="font-roc text-primary text-xs sm:text-sm tracking-[0.15em] uppercase mb-3 block"
      >
        Cases de sucesso
      </span>
      <h2
        class="font-roc text-3xl sm:text-4xl lg:text-[2.75rem] leading-[1.1] tracking-tight text-white"
      >
        Os resultados
        <br />
        não mentem
      </h2>
    </div>

    <!-- Grid dos cases -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-5">
      {
        cases.map((item) => (
          <article class="group relative flex flex-col overflow-hidden rounded-2xl border border-white/[0.08] bg-[#060b14]/60 backdrop-blur-xl shadow-[inset_0_1px_1px_rgba(255,255,255,0.1),0_8px_20px_rgba(0,0,0,0.4)] transition-all duration-300 hover:border-primary/50 hover:shadow-[inset_0_1px_1px_rgba(255,255,255,0.15),0_10px_30px_rgba(37,164,255,0.18)]">
            {/* Mídia do case: foto ou vídeo */}
            <div class="relative h-52 sm:h-56 overflow-hidden">
              {item.mediaType === "video" && item.mediaSrc ? (
                <video
                  src={item.mediaSrc}
                  poster={item.poster}
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                />
              ) : item.mediaType === "image" && item.mediaSrc ? (
                <img
                  src={item.mediaSrc}
                  alt={item.title}
                  loading="lazy"
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              ) : (
                /* Fundo decorativo (usado até o case ter foto/vídeo) */
                <div class="absolute inset-0 bg-grid-pattern" aria-hidden="true">
                  <div class="absolute -top-10 left-1/4 w-64 h-64 rounded-full bg-[radial-gradient(circle,rgba(37,164,255,0.35)_0%,transparent_70%)] blur-[60px]" />
                  <div class="absolute bottom-0 right-0 w-48 h-48 rounded-full bg-[radial-gradient(circle,rgba(37,164,255,0.2)_0%,transparent_70%)] blur-[50px]" />
                </div>
              )}
              {/* Fade para o conteúdo */}
              <div
                class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-[#060b14] to-transparent pointer-events-none"
                aria-hidden="true"
              />
              {/* Botão expandir (só existe quando o case tem página própria) */}
              {item.href && (
                <a
                  href={item.href}
                  aria-label={`Abrir case: ${item.title}`}
                  class="absolute top-4 right-4 w-9 h-9 rounded-full bg-black/50 backdrop-blur-md border border-white/15 flex items-center justify-center text-white/80 hover:text-white hover:border-primary/60 hover:bg-primary/20 transition-all duration-300"
                >
                  <ArrowUpRight class="w-4 h-4" aria-hidden="true" />
                </a>
              )}
            </div>

            {/* Conteúdo */}
            <div class="relative flex flex-1 flex-col p-6 sm:p-7">
              {/* Linhas de brilho sutil nas bordas inferior e esquerda */}
              <div
                class="absolute inset-x-0 bottom-0 h-[1.5px] bg-gradient-to-r from-primary/60 via-primary/20 to-transparent pointer-events-none"
                aria-hidden="true"
              />
              <div
                class="absolute inset-y-0 left-0 w-[1.5px] bg-gradient-to-t from-primary/60 via-primary/20 to-transparent pointer-events-none"
                aria-hidden="true"
              />

              <span class="font-roc text-[11px] sm:text-xs tracking-[0.15em] uppercase text-primary block mb-2.5">
                {item.tag}
              </span>
              <h3 class="font-roc text-base sm:text-lg leading-snug text-white mb-5">
                {item.title}
              </h3>

              {/* Métricas */}
              {item.metrics && (
                <dl class="mt-auto grid grid-cols-3 gap-3 pt-5 border-t border-white/10">
                  {item.metrics.map((metric) => (
                    <div class="flex flex-col gap-1">
                      <dt class="order-2 font-sans text-[11px] sm:text-xs text-white/55 leading-snug">
                        {metric.label}
                      </dt>
                      <dd class="order-1 font-roc text-base sm:text-lg text-white tracking-tight">
                        {metric.value}
                      </dd>
                    </div>
                  ))}
                </dl>
              )}

              {/* Entregas (cases sem métricas numéricas) */}
              {item.deliverables && (
                <ul class="mt-auto flex flex-wrap gap-2 pt-5 border-t border-white/10" aria-label="Entregas">
                  {item.deliverables.map((deliverable) => (
                    <li class="inline-flex items-center px-3.5 py-1.5 rounded-full font-roc text-xs sm:text-sm text-white bg-white/[0.04] border border-white/15">
                      {deliverable}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
