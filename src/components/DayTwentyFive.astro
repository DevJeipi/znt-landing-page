---
import { CalendarCheck, Users, PackageCheck } from "lucide-astro";

const marqueeItems = [
  "Dia 25",
  "Todas as demandas entregues",
  "Todos os clientes",
  "Todo santo mês",
];

const badges = [
  { label: "Todo mês", icon: CalendarCheck },
  { label: "Todas as demandas", icon: PackageCheck },
  { label: "Todos os clientes", icon: Users },
];
---

<section
  id="dia-25"
  class="relative bg-black overflow-hidden py-14 lg:py-20 scroll-mt-24"
  aria-label="Dia 25: nosso compromisso"
>
  {/* Marca d'água gigante */}
  <span
    class="absolute -right-4 sm:-right-8 top-1/2 -translate-y-1/2 font-roc font-semibold leading-none tracking-tight text-white/[0.05] text-[clamp(11rem,30vw,26rem)] select-none pointer-events-none"
    aria-hidden="true"
  >
    25
  </span>
  {/* Glow */}
  <div
    class="absolute top-1/2 left-0 -translate-y-1/2 w-[500px] h-[400px] rounded-full bg-[radial-gradient(circle,rgba(37,164,255,0.12)_0%,transparent_70%)] blur-[100px] pointer-events-none"
    aria-hidden="true"
  />

  <div class="relative z-10 w-full max-w-[1440px] mx-auto px-6 sm:px-8 lg:px-12">
    <p class="font-roc text-primary text-xs sm:text-sm tracking-[0.25em] uppercase mb-6 flex items-center gap-3">
      <span class="inline-block w-10 h-px bg-primary" aria-hidden="true" />
      Nosso compromisso
    </p>

    <p class="font-roc font-medium tracking-tight leading-[1.05] text-white text-[clamp(2rem,5.5vw,4.5rem)] max-w-5xl">
      É a nossa meta de todo santo
      {" "}<span class="text-primary drop-shadow-[0_0_25px_rgba(37,164,255,0.45)]">dia 25</span>{" "}
      todas as demandas estarem entregues a todos os clientes.
    </p>

    <ul class="mt-8 sm:mt-10 flex flex-wrap gap-2.5 sm:gap-3">
      {
        badges.map((badge) => {
          const IconComponent = badge.icon;
          return (
            <li class="inline-flex items-center gap-2.5 px-5 py-2.5 rounded-full font-sans text-xs sm:text-sm font-medium text-white/80 bg-white/[0.05] border border-white/15 backdrop-blur-sm">
              <IconComponent class="w-4 h-4 text-primary" stroke-width={1.75} aria-hidden="true" />
              {badge.label}
            </li>
          );
        })
      }
    </ul>
  </div>

  {/* Letreiro inferior */}
  <div
    class="relative z-10 mt-12 lg:mt-16 border-y border-white/10 py-3.5 overflow-hidden"
    aria-hidden="true"
  >
    <div class="marquee-track">
      {
        [0, 1].map((copy) => (
          <div class="flex shrink-0 items-center" aria-hidden={copy === 1 ? "true" : undefined}>
            {marqueeItems.concat(marqueeItems).map((item) => (
              <span class="flex items-center shrink-0">
                <span class="font-roc text-sm tracking-[0.2em] uppercase text-white/40 px-6">
                  {item}
                </span>
                <span class="text-primary text-xs">•</span>
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 28s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
