---
import Logo from "./Logo.astro";
import type { Locale } from "../data/site";

interface Props {
  lang?: Locale;
}

const { lang = "pt" } = Astro.props;
const isEn = lang === "en";

const navItems = isEn
  ? [
      { label: "Home", href: "#hero" },
      { label: "Services", href: "#constelacao" },
      { label: "Cases", href: "#cases" },
      { label: "Contact", href: "#contato" },
    ]
  : [
      { label: "Início", href: "#hero" },
      { label: "Serviços", href: "#constelacao" },
      { label: "Cases", href: "#cases" },
      { label: "Contato", href: "#contato" },
    ];

const ctaLabel = isEn ? "Book a diagnostic" : "Agendar diagnóstico";
const navAriaLabel = isEn ? "Main navigation" : "Navegação principal";
const openMenuLabel = isEn ? "Open navigation menu" : "Abrir menu de navegação";
const closeMenuLabel = isEn ? "Close navigation menu" : "Fechar menu de navegação";
---

<header class="fixed top-0 left-0 right-0 z-50 px-4 sm:px-8 py-4 transition-all duration-300">
  <!-- Container principal max 1440px com efeito Liquid Glass -->
  <div class="max-w-[1440px] mx-auto">
    <!-- Cápsula do Header Liquid Glass -->
    <div
      class="relative rounded-full bg-white/10 backdrop-blur-xl backdrop-saturate-150 
             border border-white/30 shadow-[0_8px_32px_rgba(0,0,0,0.15)] 
             overflow-hidden px-5 sm:px-6 py-3 sm:py-3.5 flex items-center justify-between
             before:absolute before:inset-0 before:rounded-full 
             before:bg-gradient-to-br before:from-white/40 before:via-transparent before:to-transparent 
             before:opacity-50 before:pointer-events-none"
    >
      <!-- Esquerda: Logo Real -->
      <div class="relative z-10 flex items-center">
        <Logo lang={lang} />
      </div>

      <!-- Centro: Navegação Desktop com linha animada da esquerda para a direita -->
      <nav
        class="hidden lg:flex items-center gap-6 relative z-10"
        aria-label={navAriaLabel}
      >
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="relative group/link py-1 font-sans text-sm font-medium text-white/80 hover:text-white transition-colors duration-200"
            >
              {item.label}
              <!-- Linha abaixo no hover (esquerda para a direita) -->
              <span class="absolute bottom-0 left-0 w-full h-[2px] bg-[#25a4ff] rounded-full scale-x-0 origin-left transition-transform duration-300 ease-out group-hover/link:scale-x-100"></span>
            </a>
          ))
        }
      </nav>

      <!-- Direita: Seletor de idioma, Botão Agendar Diagnóstico & Hamburger Mobile -->
      <div class="relative z-10 flex items-center gap-2.5 sm:gap-3.5">
        <!-- Seletor de Idioma (PT / EN) -->
        <div
          class="inline-flex items-center rounded-full p-0.5 bg-black/35 border border-white/20 backdrop-blur-md"
          role="group"
          aria-label={isEn ? "Select language" : "Selecionar idioma"}
        >
          <a
            href="/"
            data-lang-switch
            aria-current={!isEn ? "page" : undefined}
            aria-label="Português"
            class:list={[
              "px-2.5 py-1 rounded-full font-roc text-xs tracking-wider uppercase transition-all duration-200",
              !isEn
                ? "bg-[#25a4ff] text-white font-medium shadow-[0_0_12px_rgba(37,164,255,0.45)]"
                : "text-white/65 hover:text-white",
            ]}
          >
            PT
          </a>
          <a
            href="/en/"
            data-lang-switch
            aria-current={isEn ? "page" : undefined}
            aria-label="English"
            class:list={[
              "px-2.5 py-1 rounded-full font-roc text-xs tracking-wider uppercase transition-all duration-200",
              isEn
                ? "bg-[#25a4ff] text-white font-medium shadow-[0_0_12px_rgba(37,164,255,0.45)]"
                : "text-white/65 hover:text-white",
            ]}
          >
            EN
          </a>
        </div>

        <!-- Botão CTA sem bold -->
        <a
          href="https://form.typeform.com/to/t6XieXmB"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-2 px-6 py-2.5 rounded-full font-[family-name:var(--font-roc)] text-sm font-medium text-white bg-[#25a4ff] border border-[#25a4ff] shadow-glow-blue hover:bg-[#5cbbff] hover:border-[#5cbbff] transition-all duration-300"
        >
          {ctaLabel}
        </a>

        <!-- Botão Menu Mobile -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="lg:hidden p-2.5 rounded-full text-white/80 hover:text-white hover:bg-white/15 transition-all cursor-pointer"
          aria-label={openMenuLabel}
          data-open-label={openMenuLabel}
          data-close-label={closeMenuLabel}
          aria-expanded="false"
        >
          <span
            class="relative flex items-center justify-center w-6 h-6"
            aria-hidden="true"
          >
            <span class="hamburger-line hamburger-line-1"></span>
            <span class="hamburger-line hamburger-line-2"></span>
            <span class="hamburger-line hamburger-line-3"></span>
          </span>
        </button>
      </div>
    </div>

    <!-- Menu Mobile Dropdown em Liquid Glass -->
    <div
      id="mobile-menu"
      class="relative hidden lg:hidden mt-3 rounded-3xl bg-white/10 backdrop-blur-xl backdrop-saturate-150 
             border border-white/30 shadow-[0_8px_32px_rgba(0,0,0,0.15)] 
             overflow-hidden p-6 flex-col gap-4 animate-fade-in
             before:absolute before:inset-0 before:rounded-3xl 
             before:bg-gradient-to-br before:from-white/40 before:via-transparent before:to-transparent 
             before:opacity-50 before:pointer-events-none"
    >
      <nav class="relative z-10 flex flex-col gap-2" aria-label={navAriaLabel}>
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="mobile-nav-link px-4 py-3 rounded-xl font-sans text-base font-medium text-white/80 hover:text-white hover:bg-white/15 transition-all"
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <div class="relative z-10 pt-2 border-t border-white/15">
        <a
          href="https://form.typeform.com/to/t6XieXmB"
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-nav-link flex items-center justify-center w-full px-6 py-3.5 rounded-full font-[family-name:var(--font-roc)] text-base font-medium text-white bg-[#25a4ff] shadow-glow-blue hover:bg-[#5cbbff] transition-all"
        >
          {ctaLabel}
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Preservar posição do scroll ao alternar idioma
  const langLinks = document.querySelectorAll<HTMLAnchorElement>("[data-lang-switch]");
  langLinks.forEach((link) => {
    link.addEventListener("click", () => {
      try {
        sessionStorage.setItem("znt-scroll", String(window.scrollY));
      } catch {}
    });
  });

  // Toggle Menu Mobile
  const menuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const mobileNavLinks = document.querySelectorAll(".mobile-nav-link");

  if (menuBtn && mobileMenu) {
    const openLabel = menuBtn.dataset.openLabel || "Abrir menu de navegação";
    const closeLabel = menuBtn.dataset.closeLabel || "Fechar menu de navegação";

    menuBtn.addEventListener("click", () => {
      const isExpanded = menuBtn.getAttribute("aria-expanded") === "true";
      menuBtn.setAttribute("aria-expanded", (!isExpanded).toString());
      menuBtn.setAttribute(
        "aria-label",
        isExpanded ? openLabel : closeLabel,
      );
      mobileMenu.classList.toggle("hidden");
      mobileMenu.classList.toggle("flex");
    });

    mobileNavLinks.forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu.classList.add("hidden");
        mobileMenu.classList.remove("flex");
        menuBtn.setAttribute("aria-expanded", "false");
        menuBtn.setAttribute("aria-label", openLabel);
      });
    });
  }
</script>

<style>
  .hamburger-line {
    position: absolute;
    width: 1.25rem;
    height: 2px;
    background-color: currentColor;
    border-radius: 9999px;
    transition:
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.25s ease;
  }

  .hamburger-line-1 {
    transform: translateY(-6px);
  }

  .hamburger-line-2 {
    transform: translateY(0);
  }

  .hamburger-line-3 {
    transform: translateY(6px);
  }

  #mobile-menu-btn[aria-expanded="true"] .hamburger-line-1 {
    transform: translateY(0) rotate(45deg);
  }

  #mobile-menu-btn[aria-expanded="true"] .hamburger-line-2 {
    opacity: 0;
    transform: scaleX(0);
  }

  #mobile-menu-btn[aria-expanded="true"] .hamburger-line-3 {
    transform: translateY(0) rotate(-45deg);
  }
</style>
