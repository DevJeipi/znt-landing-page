---
import heroImage from "../assets/image-right-1.png";
import { Image } from "astro:assets";
---

<section
  id="hero"
  class="relative flex flex-col lg:flex-row items-center overflow-hidden bg-black scroll-mt-24"
  aria-label="Seção principal"
>
  <!-- Ambient background: Leves quadriculados de textura com fade no rodapé e glow sutil -->
  <div class="absolute inset-0 pointer-events-none z-0" aria-hidden="true">
    <div
      class="absolute inset-0 bg-grid-pattern [mask-image:linear-gradient(to_bottom,black_60%,transparent_100%)]"
    >
    </div>
    <div
      class="absolute top-1/4 right-5 w-[500px] h-[500px] rounded-full bg-[radial-gradient(circle,rgba(37,164,255,0.12)_0%,transparent_70%)] blur-[100px]"
    >
    </div>
    <div
      class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-black via-black/80 to-transparent"
    >
    </div>
  </div>

  <!-- Imagem grande: no mobile fica no topo (virada para baixo, acima do texto); no desktop fica posicionada à direita -->
  <div
    class="relative lg:absolute lg:inset-0 z-[5] flex items-center justify-center lg:justify-end w-full h-[260px] sm:h-[310px] lg:h-auto mt-20 sm:mt-24 lg:mt-0 overflow-hidden pointer-events-none"
    aria-hidden="true"
  >
    <div
      class="relative w-[260px] sm:w-[310px] lg:w-[800px] xl:w-[900px] shrink-0 lg:-mr-50"
    >
      <Image
        src={heroImage}
        alt="Estrela ZNT emanando luz, representação visual da estratégia de marketing"
        class="w-full h-auto object-contain rotate-90 lg:rotate-0"
        widths={[360, 480, 720, 1024, 1440]}
        sizes="(max-width: 640px) 260px, (max-width: 1024px) 310px, 900px"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        quality={85}
      />
    </div>
  </div>

  <!-- Container com largura bloqueada em 1440px -->
  <div
    class="relative z-10 w-full max-w-[1440px] mx-auto px-6 sm:px-8 lg:px-12 flex items-center pt-2 lg:pt-40 pb-12 lg:pb-20"
  >
    <!-- Conteúdo Hero (centralizado à esquerda) -->
    <div
      class="w-full lg:max-w-[60%] flex flex-col items-center lg:items-start text-center lg:text-left"
    >
      <!-- Badge: Sem borda, nem dot, apenas texto em azul -->
      <span
        class="font-roc text-primary text-xs sm:text-sm tracking-[0.15em] uppercase mb-3 animate-fade-in"
      >
        MARKETING QUE FUNCIONA DE VERDADE
      </span>

      <!-- Título Principal: Roc Grotesk -->
      <h1
        class="font-roc text-3xl sm:text-4xl md:text-5xl lg:text-[3rem] xl:text-[3.5rem] uppercase leading-[1.05] tracking-tight text-white mb-4"
      >
        <span class="block">SUA MARCA</span>
        <span class="block"
          ><span>MERECE O</span>
          <br />
          <span class="text-primary">PRÓXIMO NÍVEL</span></span
        >
      </h1>

      <!-- Parágrafo: Inter com destaque nas palavras-chave -->
      <p
        class="font-sans text-base sm:text-lg md:text-[1.15rem] text-white/85 leading-relaxed max-w-xl mb-7"
      >
        A gente faz a sua empresa <strong class="font-semibold text-white">vender mais</strong> nas redes sociais através de{" "}
        <strong class="font-semibold text-primary">estratégias de marketing com conteúdo</strong>.
      </p>

      <!-- Botões lado a lado -->
      <div
        class="flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto"
      >
        <!-- Agendar diagnóstico: totalmente arredondado com glow -->
        <a
          href="#contato"
          id="btn-agendar"
          class="group inline-flex items-center justify-center gap-2 w-full sm:w-auto px-6 py-3 rounded-full font-[family-name:var(--font-roc)] font-medium text-sm text-white bg-primary border border-primary shadow-glow-blue hover:bg-[#5cbbff] hover:border-[#5cbbff] transition-all duration-300"
        >
          Agendar diagnóstico
          <svg
            class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M3.333 8h9.334M8.667 4l4 4-4 4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>

        <!-- Ver cases: totalmente arredondado (ghost) -->
        <a
          href="#cases"
          id="btn-cases"
          class="group inline-flex items-center justify-center gap-2 w-full sm:w-auto px-6 py-3 rounded-full font-[family-name:var(--font-roc)] font-medium text-sm text-white bg-transparent border border-white/30 hover:border-white hover:bg-white/10 transition-all duration-300"
        >
          Ver cases
          <svg
            class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M3.333 8h9.334M8.667 4l4 4-4 4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
